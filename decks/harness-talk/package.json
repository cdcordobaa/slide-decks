{
  "name": "harness-talk-deck",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Card-manifest slide deck pipeline for the 'You Are the Harness' talk (Globant theme). Compiles cards/*.yaml into an editable HTML deck + renders to PDF via the create-slide-deck skill.",
  "scripts": {
    "core": "node scripts/build-blueprint-deck.mjs cards --out build/harness-blueprint.html",
    "full": "node scripts/build-blueprint-deck.mjs cards --out build/harness-blueprint-full.html --all",
    "storyboard": "node scripts/build-storyboard.mjs cards --out build/storyboard.html",
    "icons": "node scripts/vendor-icons.mjs",
    "art": "node scripts/gen-infographics.mjs cards",
    "render:core": "NODE_PATH=\"$PWD/node_modules\" node ../create-slide-deck/scripts/render-pdf.mjs build/harness-blueprint.html build/harness-blueprint.pdf --screenshots build/shots-core",
    "render:full": "NODE_PATH=\"$PWD/node_modules\" node ../create-slide-deck/scripts/render-pdf.mjs build/harness-blueprint-full.html build/harness-blueprint-full.pdf --screenshots build/shots-full",
    "pull": "node scripts/notion-sync.mjs pull",
    "push-status": "node scripts/notion-sync.mjs push-status"
  },
  "dependencies": {
    "@tabler/icons": "^3.44.0",
    "yaml": "^2.5.1"
  },
  "optionalDependencies": {
    "@notionhq/client": "^2.2.15"
  },
  "devDependencies": {
    "playwright": "^1.47.0"
  }
}
